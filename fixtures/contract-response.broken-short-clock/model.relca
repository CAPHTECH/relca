model ContractResponse version "0.2" {
  type Ack = enum { ok }
  actor Worker { capacity 1; capability run() -> Ack { duration fixed 5min; result nondet { ok } } }
  process Flow { x = Worker.run(); end done }
  bounds { cases 1; live_tasks 2; clock 4min }
  verify safety no_resource_overcommit
  contract Controls { response case.received -> one_of(end.done) by 5min after case.received otherwise unresolved }
}
