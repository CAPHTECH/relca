model M version "0.2" {
type T = enum { ok }
observed case { hit: bool = false }
actor Desk {
  grain team
  capacity 1
  capability run() -> T {
    duration fixed 3min
    result nondet { ok }
    writes hit
    finish { hit = true }
  }
}
process Flow { r = Desk.run(); end done }
cut C { include [Desk] }
policy fifo tie_by case_id
scenario BusyDay {
  arrivals fixed_every 4min during [0min, 12min)
  bounds { cases 3; live_tasks 1; clock 30min }

}
scenario SmallExact {
  arrivals fixed_every 1min during [0min, 3min)
  bounds { cases 3; live_tasks 1; clock 30min }

}
verify probability reached hit == true within 4min >= 1
}
