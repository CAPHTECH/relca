model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Seed{capacity 1;capability make()->T{duration fixed 1min;result nondet{ok}}};actor Ledger { capacity 1; state keys: set<CaseId>; capability post(key: CaseId,other:T) -> Ack {
      commits
      writes [keys, registered]
      duration fixed 1min
      atomic {
        if key in keys { result rejected_duplicate }
        else { keys += other; registered = true; result committed }
      }
      cancel forbidden_after_start
    } }
  process Flow { a = Seed.make();p=Ledger.post(case.id,a); b = Ledger.post(case.id,a); if b == rejected_duplicate { end dup } else { end twice } }
  cut K { include [Ledger,Seed] }
  bounds { cases 1; live_tasks 3; clock 20min }
  contract C { at_most_once Ledger.post.commit per case.id }
  verify reachable end.dup
}
