model ArrivalsRelativeWithin version "0.2" {
  type T = enum { ok }
  observed case { hit: bool = false }
  actor A { capacity 2; capability run() -> T { duration fixed 2min; result nondet { ok }; writes hit; finish { hit = true } } }
  process Flow { r = A.run(); end done }
  arrivals fixed [5min, 6min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 1; clock 20min }
  verify safety no_resource_overcommit
  verify probability reached hit == true within 2min >= 1
}
