model SerialTime version "0.2" {
  type Verdict = enum { pass }
  actor Office {
    capability short() -> Verdict {
      duration fixed 3min
      result nondet { pass }
    }
    capability long() -> Verdict {
      duration fixed 5min
      result nondet { pass }
    }
  }
  process Check {
    a = Office.short()
    b = Office.long()
    end done
  }
  bounds { cases 1; live_tasks 2; clock 8min }
  verify reachable end.done
}
