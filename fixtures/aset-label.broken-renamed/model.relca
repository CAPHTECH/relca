model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Book { capacity 1; state keys: set<CaseId>; capability post(key: CaseId) -> Ack {
      commits
      writes [keys, registered]
      duration fixed 1min
      atomic {
        if key in keys { result rejected_duplicate }
        else { keys += key; registered = true; result committed }
      }
      cancel forbidden_after_start
    } }
  process Flow { a = Book.post(case.id); b = Book.post(case.id); if b == rejected_duplicate { end dup } else { end twice } }
  cut K { include [Book] }
  bounds { cases 1; live_tasks 3; clock 20min }
  contract C { at_most_once Book.post.commit per case.id }
  verify reachable end.dup
}
