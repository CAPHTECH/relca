model ResourceAcceptance version "0.2" {
  type T = enum { pass,fail }
  resource R capacity 2
  actor A { capacity 2;  capability a() -> T { uses R: 1; duration fixed 2min; result nondet { pass }; cancel cooperative ack_within 1min } capability b() -> T { uses R: 1; duration fixed 6min; result nondet { fail }; cancel forbidden_after_start } capability consume(previous: T) -> T { duration fixed 1min; result nondet { pass };  } }
  process P { fork f { a = A.a(); b = A.b() }; join any f where result == pass tie by [a,b] remaining cancel_then_drain if none -> done; z = A.consume(b); end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }

  verify safety no_resource_overcommit
  verify reachable end.done
}
