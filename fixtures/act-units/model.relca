model Units version "0.2" {
  type T = enum { ok }
  actor A { capacity 1; capability run() -> T { duration fixed 1h; result nondet { ok } } }
  process Flow { a = A.run(); end done }
  cut C { include [A]; horizon job within 1d }
  bounds { cases 1; live_tasks 1; clock 2d }
  metrics { window 2d; currency "JPY"; rate A per_minute 1; rate A.run per_start 0 }
  contract Controls { response case.received -> one_of(A.run.finish) by 2d after case.received otherwise unresolved }
  verify reachable end.done
  verify safety no_resource_overcommit
}
