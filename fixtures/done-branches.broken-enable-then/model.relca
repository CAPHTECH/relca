model Completion version "0.2" {
  type T = enum { ok, good, bad }
  actor Judge { capacity 1; capability run() -> T {  duration fixed 1min; result nondet { bad, good } } }
  actor Helper { capacity 1; capability run() -> T {  duration fixed 1min; result nondet { ok } } }
  process Flow { j = Judge.run(); if j == good { h = Helper.run(); end special } else { end normal } }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify safety no_resource_overcommit
  verify recoverable end
  verify terminating end
  verify almost_sure end
  verify reachable end.normal
  verify probability reached end.normal within 10min >= 1
}
