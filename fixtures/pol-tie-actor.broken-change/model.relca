model M version "0.2" {
  type T = enum { ok, pass, bad, late }
  actor A { capacity 1; capability x() -> T { duration fixed 3min; result nondet { pass }; cancel cooperative ack_within 1min }; capability y() -> T { duration fixed 5min; result nondet { pass }; cancel cooperative ack_within 1min } }
  process P { fork f { b = A.y(); a = A.x() }; join any f where result == pass tie by [a,b] remaining cancel_then_drain if none -> done; end done }
  cut C { include [A] }
  bounds { cases 1; live_tasks 8; clock 20min }
  policy fifo tie_by case_id then call_order
  contract Due { response case.received -> one_of(end.done) by 4min after case.received otherwise unresolved }
  verify safety no_resource_overcommit
verify reachable end.done
}
