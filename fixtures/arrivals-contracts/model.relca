model ArrivalsContracts version "0.2" {
  type T = enum { ok }
  observed case { hit: bool = false }
  actor A { capacity 1; capability run() -> T { commits; duration fixed 2min; result nondet { ok }; writes hit; finish { hit = true } } }
  process Flow { r = A.run(); end done }
  arrivals fixed [0min, 0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 1; clock 20min }
  verify safety no_resource_overcommit
  contract Controls {
    invariant A.run.finish -> hit == true
    at_most_once A.run.commit per case.id
    response case.received -> one_of(end.done) by 4min after case.received otherwise unresolved
  }
}
