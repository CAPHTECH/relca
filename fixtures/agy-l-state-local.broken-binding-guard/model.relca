model AgencyFirstHalf version "0.2" {
  type V = enum { pass,fail }
  type T = enum { ok }
  observed case { flag: optional<V> }
  actor Gate { capacity 1; capability draw() -> V { writes flag; duration fixed 1min; result nondet { pass,fail } } }
  actor Worker { capacity 1; capability do() -> T {  duration fixed 1min; result nondet { ok } } }
  actor Always { capacity 1; capability do() -> T {  duration fixed 1min; result nondet { ok } } }
  process Flow { g = Gate.draw(); if g == pass { x = Worker.do() } else {}; z = Always.do(); end done }
  cut K { include [Gate,Worker,Always] }
  bounds { cases 1; live_tasks 8; clock 100min }
  verify safety no_resource_overcommit
}
