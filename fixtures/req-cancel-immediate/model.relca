model RequiresAcceptance version "0.2" {
  type T = enum { ok, pass, fail, denied, bad, posted }
  actor Fast { capacity 1; capability win() -> T { duration fixed 3min; result nondet { pass }; cancel forbidden_after_start } }
  actor Slow { capacity 1; capability work() -> T { duration fixed 10min; result nondet { ok }; cancel immediate } }
  process Flow { fork f { fast = Fast.win(); slow = Slow.work() }; join any f where result == pass tie by [fast,slow] remaining cancel_then_drain if none -> rejected; end done; end rejected }
  bounds { cases 1; live_tasks 4; clock 30min }

  verify safety no_resource_overcommit
}
