model AgencyFirstHalf version "0.2" {
  type V = enum { pass,fail }
  type T = enum { ok }
  people [c1,c2,a1]
  actor Invoice { source document }
  actor Clerk { executors [c1,c2]; capability enter() -> T {  duration fixed 1min; result nondet { ok } } }
  actor Approver { executors [a1]; capability approve(e:T) -> T {  duration fixed 1min; result nondet { ok } } }
  process Flow { e = Clerk.enter(); a = Approver.approve(e); end done }
  cut K { include [Invoice,Clerk,Approver] }
  bounds { cases 1; live_tasks 8; clock 100min }
  verify safety no_resource_overcommit
}
