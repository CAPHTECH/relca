model AgencyFirstHalf version "0.2" {
  type V = enum { pass,fail }
  type T = enum { ok }
  actor Invoice { source document }
  actor Gate { capacity 1; capability draw() -> V {  duration fixed 1min; result nondet { pass,fail } } }
  actor Worker { capacity 1; capability do() -> T { reads [Invoice]; duration fixed 1min; result nondet { ok } } }
  process Flow { g = Gate.draw(); end done; x = Worker.do(); end late }
  cut K { include [Invoice,Gate,Worker] }
  bounds { cases 1; live_tasks 8; clock 100min }
  verify safety no_resource_overcommit
}
