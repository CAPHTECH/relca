model PerCase version "0.2" {
  type Difficulty = enum { routine, difficult }
  type T = enum { ok, bad }
  people [p]
  actor Invoice { instance per_case; grain document; source document; latent difficulty: Difficulty = routine }
  observed case { scratch: bool = false }
  kernel K given [Invoice.difficulty] { routine -> { 1: ok with scratch = true }; difficult -> { 1: bad with scratch = true } }
  actor Reader { capacity 1; capability read() -> T { reads [Invoice]; kernel_reads latent [Invoice.difficulty]; writes scratch; duration fixed 1min; outcomes kernel K } }
  process Flow { a = Reader.read(); end done }
  cut Scope { question "案件ごとの文書"; include [Invoice,Reader] }
  arrivals fixed [0min, 0min]
  policy fifo tie_by case_id


  bounds { cases 2; live_tasks 2; clock 30min }
  verify probability reached scratch == true <= 1
}
