model LdConfluent version "0.2" {
  type T = enum { ok }
  actor Clerk { capacity 2
    capability enter() -> T { duration fixed 3min; result nondet { ok } }
    capability check() -> T { duration fixed 2min; result nondet { ok } }
  }
  process P { e = Clerk.enter(); k = Clerk.check(); end done }
  cut C { include [Clerk] }
  metrics { window 20min; currency "JPY"; breakdown waits }
  property case.Done = reached(end.done)
  metric quantile.DoneP95 = quantile(0.95, case.Done)
  bounds { cases 3; live_tasks 8; clock 20min }
  arrivals fixed [0min,0min,1min]
  policy observable fifo tie_by case_id then call_order assign first_idle
  simulation replications 4 seed 0 confidence 0.5
  verify reachable end.done
}
