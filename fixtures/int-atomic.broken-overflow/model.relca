model Count version "0.2" {
  type T = enum { ok, no }
  observed case { n: 0..1 = 1; flag: bool = false }
  actor A { capacity 1; capability inc() -> T { commits; duration fixed 1min; result nondet { ok }; writes [flag,n]; finish { flag = true; n += 1 } } }
  process P { a = A.inc(); if flag == true && n == 1 { end done } else { end wrong } }
  bounds { cases 1; live_tasks 1; clock 10min }
  verify reachable end.done
}
