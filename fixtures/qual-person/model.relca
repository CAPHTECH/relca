model Legacy version "0.2" {
  type T = enum { ok }
  actor A { executors [p]; capability c() -> T { duration fixed 1min; result nondet { ok }; writes owner; finish { owner = executor.id } } }
  process P { a = A.c(); end done }
  cut C { include [A] }
  bounds { cases 1; live_tasks 1; clock 10min }
  verify reachable end.done
  property case.Done = reached(end.done)
  metric cohort.Rate = expected(count(case.Done)) / arrivals
  people [p,q]
  observed case { owner: optional<PersonId> }
  property case.Owned = reached(owner == p)
  metric cohort.OwnedPerArrival = expected(count(case.Owned)) / arrivals
}
