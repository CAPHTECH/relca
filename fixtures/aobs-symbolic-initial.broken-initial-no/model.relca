model M version "0.2" {
  type R = enum { ok, no }
  actor A { capacity 1; state permit: R = no; capability commit() -> R { requires permit == ok else no; commits; duration fixed 1min; result nondet { ok } } }
  process P { a = A.commit(); end done }
  cut C { include [A] }
  bounds { cases 1; live_tasks 2; clock 20min }

  verify reachable end.done
}
