model ArrivalsSimultaneous version "0.2" {
  type T = enum { ok }
  observed case { hit: bool = false }
  actor A { capacity 1; capability run() -> T { duration {1min:0.5,3min:0.5}; result nondet { ok }; writes hit; finish { hit = true } } }
  process Flow { r = A.run(); end done }
  arrivals fixed [0min, 0min]
  bounds { cases 2; live_tasks 1; clock 20min }
  verify safety no_resource_overcommit
  verify probability reached hit == true within 1min <= 0.5
  verify probability reached hit == true within 2min >= 0.25
}
