model M version "0.2" {
  type T = enum { ok, pass, bad, late }
  latent case { hard: bool ~ { true:0.5,false:0.5 } }
  observed case { v: T = ok }
  kernel K given [hard] { true -> { 1: bad }; false -> { 1: ok } }
  actor Clerk { capacity 1; capability work() -> T { kernel_reads latent [hard]; duration fixed 2min; outcomes kernel K; writes v } }
  process P { a = Clerk.work(); end done }
  cut C { include [Clerk] }
  bounds { cases 2; live_tasks 8; clock 20min }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id then hard
  verify probability reached v == bad <= 0.5
}
