model RequiresAcceptance version "0.2" {
  type T = enum { ok, pass, fail, denied, bad, posted }
  actor A { capacity 1; capability run() -> T { duration fixed 3min; result nondet { ok };  } }
  process Flow { wait 2min; r = A.run(); end done }
  bounds { cases 2; live_tasks 4; clock 30min }
  arrivals fixed [0min,1min]
  policy fifo tie_by case_id
  metrics { window 30min; currency "JPY"; rate A per_minute 2; rate A.run per_start 3 }
  verify safety no_resource_overcommit
}
