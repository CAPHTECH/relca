model Authority version "0.2" {
  type T = enum { pass }
  people [r,q]
  actor A { executors [q]; capability run() -> T { duration fixed 5min; result nondet { pass } } }
  permit q to A.run
  authority G { basis "clock boundary"; grants q to A.run; issued_by r; expires 5min }
  process Flow { a = A.run(); end done }
  bounds { cases 1; live_tasks 2; clock 5min }
  verify safety no_resource_overcommit
  contract Controls { authority_basis A.run G }
}
