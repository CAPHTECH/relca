model ParallelTime version "0.2" {
  type Verdict = enum { pass }
  actor Office {
    capacity 2
    capability short() -> Verdict {
      duration fixed 3min
      result nondet { pass }
    }
    capability long() -> Verdict {
      duration fixed 5min
      result nondet { pass }
    }
  }
  process Check {
    fork checks {
      a = Office.short()
      b = Office.long()
    }
    end done
  }
  bounds { cases 1; live_tasks 2; clock 5min }
  verify reachable end.done
}
