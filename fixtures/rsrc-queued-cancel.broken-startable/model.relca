model ResourceAcceptance version "0.2" {
  type T = enum { pass,fail }
  resource R capacity 1
  actor A { capacity 2;  capability a() -> T { duration fixed 2min; result nondet { pass }; cancel cooperative ack_within 1min } capability b() -> T { uses R: 1; duration fixed 6min; result nondet { fail }; cancel cooperative ack_within 1min } }
  process P { fork f { a = A.a(); b = A.b() }; join any f where result == pass tie by [a,b] remaining cancel_then_drain if none -> done; end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }

  verify safety no_resource_overcommit
  verify reachable end.done
}
