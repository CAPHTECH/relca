model Control version "0.2" {
  type T = enum { ok }
  actor A { control environment; capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  actor B { }
  process Flow { a = A.run(); end done }
  bounds { cases 1; live_tasks 1; clock 3min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
