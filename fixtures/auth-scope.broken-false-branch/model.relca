model Authority version "0.2" {
  type T = enum { pass, fail }
  people [r,p,q,z]
  observed case { approval: optional<T> }
  actor Judge { executors [p]; capability judge() -> T { duration fixed 1min; result nondet { pass, fail }; writes approval } }
  actor A { executors [q]; capability run() -> T { duration fixed 2min; result nondet { pass } } }
  permit p to Judge.judge
  permit q to A.run
  authority G { basis "scope"; grants q to A.run; issued_by r; scope approval == pass }
  process Flow { j = Judge.judge(); a = A.run(); end done }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  contract Controls { authority_basis A.run G }
}
