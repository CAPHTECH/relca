model Fifo version "0.2" {
  type T = enum { ok }
  observed case { hit:bool = false }
  actor A { capacity 1; capability c() -> T { duration fixed 1min; result nondet { ok }; writes hit; finish { hit = true } } }
  process P { a = A.c(); end done }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 1; clock 3min }
  verify probability reached hit == true >= 0
  verify reachable end.done
  simulation replications 4 seed 0 confidence 0.5
}
