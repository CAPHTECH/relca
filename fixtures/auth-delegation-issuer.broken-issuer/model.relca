model Authority version "0.2" {
  type T = enum { pass }
  people [r,p,q,z]
  actor A { executors [q]; capability run() -> T { duration fixed 2min; result nondet { pass } }; capability other() -> T { duration fixed 1min; result nondet { pass } } }
  permit q to A.run
  authority Parent { basis "capability-indexed grants"; grants q to A.run; grants p to A.other; issued_by r; expires 10min }
  authority Child { basis "child"; grants q to A.run; issued_by p; expires 5min; delegated_from Parent }
  process Flow { a = A.run(); end done }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  contract Controls { authority_basis A.run Child }
}
