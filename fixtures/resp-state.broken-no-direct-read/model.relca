model ResponsibilityState version "0.2" {
  type Entry = enum { entry }
  type Verdict = enum { pass, fail }
  type Ack = enum { committed }
  people [a1]
  observed case { registered: bool = false; approval: optional<Verdict> }
  actor Invoice { source document }
  actor Reader { capacity 1; capability enter() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor Approver { executors [a1]; capability approve(e:Entry) -> Verdict { writes approval; duration fixed 1min; result nondet { pass,fail } } }
  actor Ledger { capacity 1; capability post(v:Verdict) -> Ack { commits; writes registered; finish { registered = true }; duration fixed 1min; result nondet { committed } } }
  responsible a1 for (registered == false || approval == pass)
  process Flow {
    entry = Reader.enter()
    ap = Approver.approve(entry)
    if ap == pass { } else { end returned }
    posted = Ledger.post(ap)
    end done
  }
  cut Scope { include [Invoice,Reader,Approver,Ledger] }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
}
