model DiffTime version "0.2" {
  type V = enum { pass }
  actor A {
    capacity 2
    capability a() -> V { duration fixed 1min; result nondet { pass } }
    capability b() -> V { duration fixed 1min; result nondet { pass } }
    capability c() -> V { duration fixed 1min; result nondet { pass } }
  }
  process Before { x = A.a(); y = A.b(); end done }
  process After { x = A.a(); z = A.c(); end done }
  cut C { include [A] }
  configuration From { cut C; process Before }
  configuration To { cut C; process After }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
}
