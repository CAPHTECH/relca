model ResourceAcceptance version "0.2" {
  type T = enum { ok }
  resource R capacity 18446744073709551615
  actor A { capacity 2;  capability x() -> T { uses R: 18446744073709551614; duration fixed 1min; result nondet { ok };  } capability y() -> T { uses R: 1; duration fixed 1min; result nondet { ok };  } }
  process P { fork f { a = A.x(); b = A.y() }; join all f; end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }

  verify safety no_resource_overcommit
  verify reachable end.done
}
