model ResourceAcceptance version "0.2" {
  type T = enum { ok,denied }
  resource R capacity 1
  actor A { capacity 2;  capability x() -> T { uses R: 1; duration fixed 3min; result nondet { ok }; writes flag; finish { flag = true } } capability y() -> T { duration fixed 1min; result nondet { ok }; requires flag == true else denied } }
  process P { fork f { a = A.x(); b = A.y() }; join all f; end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }
  observed case { flag: bool = false }
  verify safety no_resource_overcommit
  verify reachable end.done
}
