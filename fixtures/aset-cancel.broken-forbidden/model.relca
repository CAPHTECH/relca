model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger {capacity 1;state keys:set<CaseId>;capability post(key: CaseId) -> Ack {
      commits
      writes [keys, registered]
      duration fixed 3min
      atomic {
        if key in keys { result rejected_duplicate }
        else { keys += key; registered = true; result committed }
      }
      cancel forbidden_after_start
    }};actor Fast {capacity 1;capability go()->Ack{duration fixed 1min;result nondet{committed};cancel forbidden_after_start}}
  process Flow { fork f {a=Ledger.post(case.id);q=Fast.go()};join any f where result==committed tie by [q,a] remaining cancel_then_drain if none -> dup;b=Ledger.post(case.id);if b==committed{end posted}else{end dup} }
  cut K { include [Ledger,Fast] }
  bounds { cases 1; live_tasks 3; clock 20min }
  contract C { at_most_once Ledger.post.commit per case.id }
  verify reachable end.posted
}
