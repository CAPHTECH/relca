model Records version "0.2" {
type Verdict = enum { pass, fail }
type Ack = enum { committed, refused }
type Entry = record { confidence: enum { high, low } }
observed case { entry: optional<Entry>; approval: optional<Verdict>; registered: bool = false }
actor Extractor { capacity 1; capability extract() -> Entry { duration fixed 1min; result nondet { Entry { confidence = high }, Entry { confidence = low } } } }
actor Clerk { capacity 1; capability review(e: Entry) -> Verdict { duration fixed 3min; result nondet { pass, fail } } }
process Flow { e = Extractor.extract(); if entry.confidence == low { r = Clerk.review(e); end reviewed } else { end auto } }

bounds { cases 1; live_tasks 1; clock 20min }
verify safety no_resource_overcommit
verify reachable end.reviewed
verify reachable end.auto
}
