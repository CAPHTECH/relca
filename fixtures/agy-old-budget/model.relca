model AgencyOrigin version "0.2" {
  type Entry = enum { entry }
  type Verdict = enum { pass, fail }
  type Ack = enum { committed }
  actor Invoice { source document }
  actor Reader {
    capacity 1
    capability enter() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } }
  }
  actor Reviewer {
    capacity 1
    capability review(e:Entry) -> Verdict { reads [Invoice]; duration fixed 1min; result nondet { pass, fail } }
  }
  actor Ledger {
    capacity 1
    capability post(v:Verdict) -> Ack { commits; duration fixed 1min; result nondet { committed } }
  }
  process Flow {
    entry = Reader.enter()
    approval = Reviewer.review(entry)
    if approval == pass { } else { end rejected }
    posted = Ledger.post(approval)
    end done
  }
  bounds { cases 1; live_tasks 4; clock 32min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
