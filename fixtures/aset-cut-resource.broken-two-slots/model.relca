model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  resource erp_slots capacity 2; actor Poster { capacity 2; capability post()->Ack {commits;uses erp_slots:1;duration fixed 1min;result nondet{committed}}}
  process Flow { a=Poster.post();end done }
  cut K { include [Poster] }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 3; clock 20min }
  contract C{at_most_once Poster.post.commit per case.id}
  verify reachable end.done
}
