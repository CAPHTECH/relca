model Grain version "0.2" {
  type T = enum { ok }
  actor A { grain person; capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  actor B { grain ledger; capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  process Flow { a = A.run(); b = B.run(); end done }
  bounds { cases 1; live_tasks 2; clock 3min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
