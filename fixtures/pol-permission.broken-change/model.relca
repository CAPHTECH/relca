model M version "0.2" {
  type T = enum { ok, pass, bad, late }
  people [p,q]
  actor A { executors [q,p];  capability work() -> T {  duration fixed 1min; result nondet { ok }; cancel cooperative ack_within 1min } }

  process P { a = A.work(); end done }
  cut C { include [A] }
  bounds { cases 1; live_tasks 8; clock 20min }
  policy fifo tie_by case_id assign first_idle
  permit q to A.work
  contract Ctl { permitted A.work }
  verify safety no_resource_overcommit
verify reachable end.done
}
