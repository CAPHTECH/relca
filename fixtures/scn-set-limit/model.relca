model M version "0.2" {
type T = enum { ok }
actor L { state keys: set<CaseId> }
actor A { capacity 1; capability c() -> T { duration fixed 1min; result nondet { ok } } }
process P { r = A.c(); end done }
cut C { include [L,A] }
scenario Small {
  arrivals fixed [0min, 0min]
  bounds { cases 2; live_tasks 1; clock 30min }

}
scenario Large {
  arrivals fixed [0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min, 0min]
  bounds { cases 64; live_tasks 1; clock 30min }

}
verify reachable end.done
}
