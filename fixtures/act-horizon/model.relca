model Horizon version "0.2" {
  type T = enum { ok }
  actor A { capacity 1; capability run() -> T { duration fixed 2min; result nondet { ok } } }
  process Flow { a = A.run(); end done }
  cut C { include [A]; horizon receipt..resolution within 1h; contest within 5d structural_only; reentry [review cut quarterly] }
  bounds { cases 1; live_tasks 1; clock 3min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
