model M version "0.2" {
  type T = enum { ok, pass, bad, late }
  people [c1,c2]
  observed case { v: T = ok }
  kernel K { * -> { 0.9: ok; 0.1: bad } }
  actor Clerk { executors [c1,c2]; capability work() -> T { duration fixed 3min; outcomes kernel K; writes v } }
  process P { a = Clerk.work(); end done }
  cut C { include [Clerk] }
  bounds { cases 2; live_tasks 8; clock 20min }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id then call_order
  verify probability reached v == bad <= 0.1
}
