model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger { capacity 1; state keys: set<CaseId>; capability post(key: T) -> Ack {
      commits

      duration fixed 1min
      result nondet{committed}
      cancel forbidden_after_start
    } }
  process Flow { a = Ledger.post(case.id); b = Ledger.post(case.id); if b == committed { end dup } else { end twice } }
  cut K { include [Ledger] }
  bounds { cases 1; live_tasks 3; clock 20min }

  verify reachable end.dup
}
