model Conflict version "0.2" {
  type R = enum { committed, conflict }
  type H = enum { free, taken }
  resource ledger_lock capacity 1
  actor Ledger {
    capacity 2
    state holder: H = free
    state claims: 0..2 = 0
    capability claim() -> R {
      uses ledger_lock: 1
      commits
      duration fixed 1min
      result nondet { committed }
      writes [holder, claims]
      finish { holder = taken; claims += 1 }
    }
  }
  process P {
    r = Ledger.claim()
    end claimed
  }
  cut C { include [Ledger] }
  bounds { cases 1; live_tasks 2; clock 10min }
  policy fifo tie_by case_id
  verify reachable end.claimed
}
