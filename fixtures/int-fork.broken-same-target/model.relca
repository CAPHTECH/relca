model Count version "0.2" {
  type T = enum { ok, no }
  observed case { n: 0..2 = 0; m: 0..2 = 0 }
  actor A { capacity 1; capability inc() -> T { duration fixed 1min; result nondet { ok }; writes n; finish { n += 1 } } }
  actor B { capacity 1; capability inc() -> T { duration fixed 1min; result nondet { ok }; start { n += 1 } } }
  process P { fork f { a = A.inc(); b = B.inc() }; join all f; if n == 1 && m == 1 { end done } else { end wrong } }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify reachable end.done
}
