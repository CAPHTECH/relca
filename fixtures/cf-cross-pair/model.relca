model Pair version "0.2" {
 type Pick=enum{left,right};type R=enum{committed,conflict};type H=enum{free,taken}
 resource RA capacity 1;resource RB capacity 1; actor Picker{capacity 2;capability choose()->Pick{duration fixed 1min;result nondet{left,right}}}
 actor Ledger{capacity 2;state holder:H=free;
 capability a()->R{uses RA:1;version_check [holder] else conflict;commits;writes holder;finish{holder=taken};duration fixed 1min;result nondet{committed}}
 capability b()->R{uses RB:1;version_check [holder] else conflict;commits;writes holder;finish{holder=taken};duration fixed 1min;result nondet{committed}}}
 process P{p=Picker.choose();if p==left {a=Ledger.a()} else {b=Ledger.b()};end done}
 cut C{include[Picker,Ledger]};bounds{cases 2;live_tasks 1;clock 10min};arrivals fixed[0min,0min];policy fifo tie_by case_id;verify safety no_resource_overcommit
}
