model Summary version "0.2" {
  type Entry = enum { entry }
  type Verdict = enum { pass, fail }
  type Ack = enum { posted }
  actor Invoice { source document }
  actor PurchaseOrder { source record }
  actor Extract { via model "doc@v3"; capacity 1; capability make() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor Clerk { capacity 1; capability note(e:Entry) -> Verdict { duration fixed 1min; result nondet { pass, fail } } capability match_po(e:Entry) -> Verdict { reads [PurchaseOrder]; duration fixed 1min; result nondet { pass, fail } } }
  actor Sink { capacity 1; capability post() -> Ack { commits; duration fixed 1min; result nondet { posted } } }
  process Flow {
    e = Extract.make(); p = Clerk.match_po(e); n = Clerk.note(e)

    z = Sink.post(); end done
  }
  cut Scope { include [Invoice,PurchaseOrder,Extract,Clerk,Sink] }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
