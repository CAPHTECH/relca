model StateInvariant version "0.2" {
  type R = enum { ok }
  observed case { ok: bool = true }
  actor Bad { capacity 1; capability bad() -> R { duration fixed 1min; result nondet { ok }; writes ok; finish { ok = false } } }
  actor Fix { capacity 1; capability fix() -> R { duration fixed 1min; result nondet { ok }; start { ok = true } } }
  process Flow { b = Bad.bad(); r = Fix.fix(); end done }
  cut C { include [Bad, Fix] }
  bounds { cases 1; live_tasks 2; clock 10min }

  contract Controls { invariant ok == true }
}
