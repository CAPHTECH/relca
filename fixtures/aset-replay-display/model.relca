model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger{capacity 1;state keys:set<CaseId>;capability post(key: CaseId) -> Ack {
      commits
      writes [keys, registered]
      duration fixed 1min
      atomic {
        if key in keys { result rejected_duplicate }
        else { keys += key; registered = true; result committed }
      }
      cancel forbidden_after_start
    }};actor Probe{capacity 1;capability go()->Ack{duration fixed 1min;result nondet{committed}}}
  process Flow { a=Ledger.post(case.id);wait 3min;q=Probe.go();end done }
  cut K { include [Ledger,Probe] }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 3; clock 20min }
  contract C { at_most_once Ledger.post.commit per case.id };contract I{invariant Probe.go.finish -> registered==false}
  verify reachable end.done
}
