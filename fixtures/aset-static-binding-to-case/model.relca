model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger{capacity 1;capability make()->T{duration fixed 1min;result nondet{ok}};capability take(k:CaseId)->Ack{duration fixed 1min;result nondet{committed}}}
  process Flow { a=Ledger.make();b=Ledger.take(case.id);end done }
  cut K { include [Ledger] }
  bounds { cases 1; live_tasks 3; clock 20min }

  verify reachable end.done
}
