model ResponsibilityContest version "0.2" {
  type Entry = enum { entry }
  type Verdict = enum { pass, fail }
  people [c1,a1,cfo]
  actor Invoice { source document }
  actor Reader { capacity 1; capability enter() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor Clerk { executors [c1]; capability recheck() -> Verdict { duration fixed 1min; result nondet { pass,fail } } }
  actor Approver { executors [a1]; capability approve(e:Entry) -> Verdict { duration fixed 1min; result nondet { pass,fail } } }
  actor Vendor {
    control party
    standing over [end.returned] basis "invoice claim"
  }
  permit a1 to Approver.approve
  authority ApprovalGrant { basis "approval table"; grants a1 to Approver.approve; issued_by cfo }
  process Flow {
    entry = Reader.enter()
    approval = Approver.approve(entry)
    if approval == fail { end returned } else { end posted }
  }
  cut Scope { include [Invoice,Reader,Clerk,Approver,Vendor]; defer Vendor.contest reason "structure only" loses "dispute frequency" }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  contract Controls {
     authority_basis Approver.approve ApprovalGrant
  }
}
