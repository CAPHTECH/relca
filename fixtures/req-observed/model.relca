model RequiresAcceptance version "0.2" {
  type T = enum { ok, pass, fail, denied, bad, posted }
  observed case { flag: bool = true }
  actor A { capacity 1; capability run() -> T { duration fixed 4min; result nondet { ok }; requires flag == true else denied } }
  process Flow { r = A.run(); end done }
  bounds { cases 1; live_tasks 4; clock 30min }

  verify safety no_resource_overcommit
}
