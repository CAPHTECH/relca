model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate, conflict }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger { capacity 2; state keys: set<CaseId>; capability post(key: CaseId) -> Ack {
      version_check [keys] else conflict
      commits
      writes [keys, registered]
      duration fixed 1min
      atomic {
        if key in keys { result rejected_duplicate }
        else { keys += key; registered = true; result committed }
      }
      cancel forbidden_after_start
    } }
  process Flow { a = Ledger.post(case.id); if a==committed {end done} else {end conflict_end} }
  cut K { include [Ledger] }
  arrivals fixed [0min,0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 3; clock 20min }
  contract C { at_most_once Ledger.post.commit per case.id }
  verify reachable end.done
 verify reachable end.conflict_end
}
