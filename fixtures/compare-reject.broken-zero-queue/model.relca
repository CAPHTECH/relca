model CompareReject version "0.2" {
  type T = enum { ok }
  observed case { hit:bool = false }
  actor A {
    capacity 1
    capability long() -> T { duration fixed 4min; result nondet { ok }; writes hit; finish { hit = true } }
    capability fast() -> T { duration fixed 1min; result nondet { ok }; writes hit; finish { hit = true } }
  }
  process P { a = A.long(); end done }
  process Q { a = A.fast(); end done }
  cut C { include [A] }
  configuration Aplan { cut C; process P }
  configuration Bplan { cut C; process Q }
  arrivals fixed [0min,1min,2min]
  policy fifo tie_by case_id
  queue capacity 0 on_overflow reject
  bounds { cases 3; live_tasks 1; clock 10min }
  verify probability reached hit == true >= 0
}
