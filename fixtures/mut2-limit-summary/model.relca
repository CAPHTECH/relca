  actor Probe { capacity 1; capability read() -> Entry { reads [BudgetSource00,BudgetSource01,BudgetSource02,BudgetSource03,BudgetSource04,BudgetSource05,BudgetSource06,BudgetSource07,BudgetSource08,BudgetSource09,BudgetSource10,BudgetSource11,BudgetSource12,BudgetSource13,BudgetSource14,BudgetSource15,BudgetSource16,BudgetSource17,BudgetSource18,BudgetSource19,BudgetSource20,BudgetSource21,BudgetSource22,BudgetSource23,BudgetSource24,BudgetSource25,BudgetSource26,BudgetSource27,BudgetSource28,BudgetSource29,BudgetSource30,BudgetSource31,BudgetSource32,BudgetSource33,BudgetSource34,BudgetSource35,BudgetSource36,BudgetSource37,BudgetSource38,BudgetSource39,BudgetSource40,BudgetSource41,BudgetSource42,BudgetSource43,BudgetSource44,BudgetSource45,BudgetSource46,BudgetSource47,BudgetSource48,BudgetSource49,BudgetSource50,BudgetSource51,BudgetSource52,BudgetSource53,BudgetSource54,BudgetSource55,BudgetSource56,BudgetSource57,BudgetSource58,BudgetSource59]; duration fixed 1min; result nondet { entry } } }
  actor Invoice { source document }
  actor PurchaseOrder { source record }
  actor Extract { via model "doc@v3"; capacity 1; capability make() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor Clerk { capacity 1; capability note(e:Entry) -> Verdict { duration fixed 1min; result nondet { pass, fail } } capability match_po(e:Entry) -> Verdict { reads [PurchaseOrder]; duration fixed 1min; result nondet { pass, fail } } }
  actor Approver { capacity 1; executors [a1]; capability approve(e:Entry) -> Verdict { duration fixed 1min; result nondet { pass, fail } } }
  actor Ledger { capacity 1; capability post(p:Verdict,a:Verdict) -> Ack { commits; duration fixed 1min; result nondet { posted } } }
  authority G { basis "budget"; grants a1 to Approver.approve; issued_by cfo }
  contract C { authority_basis Approver.approve G }
  process Flow {
    e = Extract.make(); p = Clerk.match_po(e); a = Approver.approve(e); n = Clerk.note(e)
    if p == pass && a == pass && n == pass {} else { end rejected }
    z = Ledger.post(p,a); end done
  }
  cut Scope { include [Invoice,PurchaseOrder,Extract,Clerk,Approver,Ledger,Probe,BudgetSource00,BudgetSource01,BudgetSource02,BudgetSource03,BudgetSource04,BudgetSource05,BudgetSource06,BudgetSource07,BudgetSource08,BudgetSource09,BudgetSource10,BudgetSource11,BudgetSource12,BudgetSource13,BudgetSource14,BudgetSource15,BudgetSource16,BudgetSource17,BudgetSource18,BudgetSource19,BudgetSource20,BudgetSource21,BudgetSource22,BudgetSource23,BudgetSource24,BudgetSource25,BudgetSource26,BudgetSource27,BudgetSource28,BudgetSource29,BudgetSource30,BudgetSource31,BudgetSource32,BudgetSource33,BudgetSource34,BudgetSource35,BudgetSource36,BudgetSource37,BudgetSource38,BudgetSource39,BudgetSource40,BudgetSource41,BudgetSource42,BudgetSource43,BudgetSource44,BudgetSource45,BudgetSource46,BudgetSource47,BudgetSource48,BudgetSource49,BudgetSource50,BudgetSource51,BudgetSource52,BudgetSource53,BudgetSource54,BudgetSource55,BudgetSource56,BudgetSource57,BudgetSource58,BudgetSource59] }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify reachable end.done
  verify safety no_resource_overcommit
