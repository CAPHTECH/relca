model ResourceAcceptance version "0.2" {
  type T = enum { ok,denied }
  resource R capacity 2
  actor A { capacity 1;  capability x() -> T { uses R: 2; duration fixed 3min; result nondet { ok }; requires flag == true else denied } capability y() -> T { uses R: 2; duration fixed 2min; result nondet { ok };  } }
  process P { x = A.x(); y = A.y(); end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }
  observed case { flag: bool = false }
  verify safety no_resource_overcommit
  verify reachable end.done
}
