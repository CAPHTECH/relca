model AgencyFirstHalf version "0.2" {
  type V = enum { pass,fail }
  type T = enum { ok }
  actor Planner { capacity 1; capability propose() -> T {  duration fixed 1min; result nondet { ok } } }
  process Flow { p = Planner.propose(); end done }
  cut K { include [Planner] }
  bounds { cases 1; live_tasks 8; clock 100min }
  verify safety no_resource_overcommit
}
