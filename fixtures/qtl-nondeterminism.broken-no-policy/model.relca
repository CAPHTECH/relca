model Qtl version "0.2" {
  type T = enum { ok }
  actor A { capacity 1; capability run() -> T { duration fixed 3min; result nondet { ok } } }
  process P { job = A.run(); end done }
  cut C { include [A] }
  arrivals fixed [0min, 0min]
  bounds { cases 2; live_tasks 1; clock 10min }
  verify reachable end.done
  property case.Done = reached(end.done)
  metric quantile.Median = quantile(0.5, case.Done)
  metric quantile.MedianDone = quantile(0.5, case.Done given reached)
  simulation replications 4 seed 1 confidence 0.5
}
