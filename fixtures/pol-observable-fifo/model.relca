model M version "0.2" {
  type T = enum { ok, pass, bad, late }
  actor A { capacity 1;  capability work() -> T {  duration fixed 1min; result nondet { ok }; cancel cooperative ack_within 1min } }

  process P { a = A.work(); end done }
  cut C { include [A] }
  bounds { cases 2; live_tasks 8; clock 20min }
  arrivals fixed [0min,0min]
  policy observable fifo tie_by case_id
  simulation replications 4 seed 0 confidence 0.5
  verify reachable end.done
}
