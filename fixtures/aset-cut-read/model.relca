model CaseSet version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  type T = enum { ok, no }
  people [c1,c2]
  observed case { registered: bool = false }

  actor Ledger {state keys:set<CaseId>};actor Probe{capacity 1;capability go()->Ack{duration fixed 1min;result nondet{committed}}}
  process Flow { a=Probe.go();end done }
  cut K { include [Ledger,Probe] }
  bounds { cases 1; live_tasks 3; clock 20min }
  contract I{invariant Probe.go.finish -> (case.id in Ledger.keys || registered==false)}
  verify reachable end.done
}
