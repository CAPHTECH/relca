model ProbabilityMDP version "0.2" {
  type Mode = enum { safe, risky }
  type T = enum { ok }
  observed case { mode: Mode = safe; hit: bool = false }
  kernel K given [mode] {
    safe -> { 0.25: ok with hit = true; 0.75: ok with hit = false }
    risky -> { 0.75: ok with hit = true; 0.25: ok with hit = false }
  }
  actor A { capacity 1
    capability choose() -> Mode { duration fixed 1min; result nondet { safe, risky }; writes mode }
    capability sample() -> T { duration fixed 1min; outcomes kernel K; writes hit }
  }
  process Flow { c = A.choose(); s = A.sample(); if hit == true { end bad } else { end good } }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  verify probability reached hit == true <= 0.5
}
