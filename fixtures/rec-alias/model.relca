model Records version "0.2" {
type Verdict = enum { pass, fail }
type Ack = enum { committed, refused }
type Entry = record { confidence: enum { high, low } }
observed case { entry: optional<Entry>; approval: optional<Verdict>; registered: bool = false }
actor Extractor { capacity 1; capability extract() -> Entry { duration fixed 1min; result nondet { Entry { confidence = high } }; writes entry } }
actor Updater { capacity 1; capability run() -> Ack { duration fixed 1min; result nondet { committed }; writes entry; finish { entry = Entry { confidence = low } } } }
process Flow { entry = Extractor.extract(); u = Updater.run(); if entry.confidence == low { end fresh } else { end stale } }

bounds { cases 1; live_tasks 1; clock 20min }
verify safety no_resource_overcommit
verify reachable end.fresh
}
