model MeanWorkContention version "0.2" {
  type T = enum { ok }
  people [p]
  actor A { executors [p]; capability run() -> T { duration fixed 3min; result nondet { ok } } }
  process P { job = A.run(); end done }
  cut C { include [A] }
  arrivals fixed [0min, 0min]
  bounds { cases 2; live_tasks 1; clock 10min }
  metrics { window 10min; currency "JPY"; rate A per_minute 10; rate A.run per_start 1 }
  verify reachable end.done
  property case.Done = reached(end.done)
  metric mean.Lead = mean(elapsed, case.Done)
  metric mean.Work = mean(work)
  metric mean.People = mean(named_people_work)
  metric mean.Cost = mean(cost)
}
