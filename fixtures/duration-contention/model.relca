model DurationContention version "0.2" {
  type T = enum { ok }
  observed case { leftDone: bool = false; rightDone: bool = false }
  actor A {
    capacity 1
    capability left() -> T { duration {3min:0.5,5min:0.5}; result nondet { ok }; writes leftDone; finish { leftDone = true } }
    capability right() -> T { duration {3min:0.5,5min:0.5}; result nondet { ok }; writes rightDone; finish { rightDone = true } }
  }
  process Flow { fork f { l = A.left(); r = A.right() }; join all f; end done }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  verify probability reached leftDone == true && rightDone == true within 6min >= 0.25
  verify probability reached leftDone == true && rightDone == true within 5min <= 0
}
