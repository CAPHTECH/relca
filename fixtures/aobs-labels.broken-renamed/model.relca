model M version "0.2" {
  type R = enum { committed, rejected }
  actor Registry {
    capacity 1
    state posted: 0..1 = 0
    capability post() -> R {
      requires posted == 0 else rejected
      duration fixed 1min
      result nondet { committed }
      writes posted
      finish { posted += 1 }
    }
  }
  process P { r = Registry.post(); if r == committed { end posted } else { end denied } }
  cut C { include [Registry] }
  bounds { cases 2; live_tasks 1; clock 10min }
  arrivals fixed [0min,0min]
  verify safety no_resource_overcommit
}
