model Completion version "0.2" {
  type T = enum { ok, good, bad }
  actor Judge { capacity 1; capability run() -> T {  duration fixed 1min; result nondet { bad } } }
  actor Ledger { capacity 1; capability post() -> T { commits; duration fixed 1min; result nondet {ok} } }
  process Flow { j = Judge.run(); if j == good { x = Ledger.post(); end registered } else { end returned } }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify safety no_resource_overcommit
  verify recoverable end
  verify terminating end
  verify almost_sure end
  verify reachable end.registered
  verify probability reached end.registered within 10min >= 1
  contract Controls { invariant Ledger.post.commit -> j == good }
}
