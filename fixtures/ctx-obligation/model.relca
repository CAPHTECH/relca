model Obligation version "0.2" {
  type T = enum { ok, bad }
  actor A { capacity 1; capability stop() -> T { duration fixed 1min; result nondet { ok } } }
  actor B { capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  actor Wait { capacity 1; capability run() -> T { duration fixed 5min; result nondet { ok } } }
  process Flow { a = A.stop(); if a == ok { b = B.run() } else { w = Wait.run() }; end done }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
  contract Controls {
    response case.received -> one_of(B.run.finish) by 4min after case.received otherwise unresolved
    excludes A.stop.finish(bad), B.run.start
  }
}
