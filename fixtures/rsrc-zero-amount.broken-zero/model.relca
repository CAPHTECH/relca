model ResourceAcceptance version "0.2" {
  type T = enum { ok }
  resource R capacity 1
  actor A { capacity 1;  capability x() -> T { uses R: 0; duration fixed 1min; result nondet { ok };  } }
  process P { x = A.x(); end done }
  cut K { question "resource acceptance"; include [A] }
  bounds { cases 1; live_tasks 3; clock 10min }
  metrics { window 10min; currency "JPY" }

  verify safety no_resource_overcommit
  verify reachable end.done
}
