model RequiresAcceptance version "0.2" {
  type T = enum { ok, pass, fail, denied, bad, posted }
  observed case { approval: optional<T> }
  actor Source { source document }
  actor Producer { capacity 1; capability produce() -> T { reads [Source]; duration fixed 1min; result nondet { ok } } }
  actor Judge { capacity 1; capability check(e:T) -> T { writes approval; duration fixed 1min; result nondet { pass, fail } } }
  actor Post { capacity 1; capability post(v:T) -> T { duration fixed 1min; result nondet { posted }; commits } }
  process Flow { e = Producer.produce(); j = Judge.check(e); p = Post.post(j); if p == posted { end posted } else { end returned } }
  bounds { cases 1; live_tasks 4; clock 30min }

  verify safety no_resource_overcommit
}
