model ArrivalUnits version "0.2" {
  type T = enum { ok }
  actor A { capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  process Flow { a = A.run(); end done }
  arrivals fixed [30min,1h]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 2; clock 2h }
  metrics { window 2h; currency "JPY"; rate A per_minute 1; rate A.run per_start 0 }
  verify reachable end.done
  verify safety no_resource_overcommit
}
