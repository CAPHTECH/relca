model Records version "0.2" {
type T = enum { a, b }
observed case { c: T = a }
actor Work { state s: enum {a,b} = a; capacity 1; capability run() -> T { duration fixed 1min; result nondet { a } } }
process Flow { x = Work.run(); end done }

bounds { cases 1; live_tasks 1; clock 20min }
verify safety no_resource_overcommit
verify reachable end.done
}
