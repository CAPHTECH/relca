model Legacy version "0.2" {
  type T = enum { ok }
  actor A { capacity 2; capability c() -> T { duration fixed 1min; result nondet { ok } } }
  process P { fork jobs { a = A.c(); b = A.c() }; join all jobs; end done }
  cut C { include [A] }
  bounds { cases 1; live_tasks 2; clock 10min }
  verify reachable end.done
  property case.Done = reached(end.done)
  metric cohort.Rate = expected(count(case.Done)) / arrivals
}
