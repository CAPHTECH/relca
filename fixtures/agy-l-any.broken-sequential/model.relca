model AgencyFirstHalf version "0.2" {
  type V = enum { pass,fail }
  type T = enum { ok }
  actor A { capacity 1; capability draw() -> V { cancel immediate; duration fixed 1min; result nondet { pass,fail } } }
  actor B { capacity 1; capability draw() -> V { cancel immediate; duration fixed 1min; result nondet { pass,fail } } }
  process Flow { a = A.draw(); if a == pass {} else { b = B.draw() }; end done }
  cut K { include [A,B] }
  bounds { cases 1; live_tasks 8; clock 100min }
  verify safety no_resource_overcommit
}
