model DebtorActor version "0.2" {
  type T = enum { ok }
  actor Worker { capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  process Flow { w = Worker.run(); end done }
  bounds { cases 1; live_tasks 1; clock 3min }
  contract Controls { response delivery: case.received -> one_of(Worker.run.finish) by 2min after case.received otherwise unresolved }
  verify reachable end.done
  verify safety no_resource_overcommit
}
