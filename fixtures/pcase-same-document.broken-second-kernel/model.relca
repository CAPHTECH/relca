model PerCase version "0.2" {
  type Difficulty = enum { routine, difficult }
  type T = enum { ok, bad }
  people [p]
  actor Invoice { instance per_case; grain document; source document; latent difficulty: Difficulty ~ { routine:0.8, difficult:0.2 } }
  observed case { left: optional<Difficulty>; right: optional<Difficulty> }
  kernel K given [Invoice.difficulty] { routine -> { 1: routine with left = routine }; difficult -> { 1: difficult with left = difficult } }
  kernel L { * -> { 0.8: routine with right = routine; 0.2: difficult with right = difficult } }
  actor Reader { capacity 1
    capability first() -> Difficulty { reads [Invoice]; kernel_reads latent [Invoice.difficulty]; writes left; duration fixed 1min; outcomes kernel K }
    capability second() -> Difficulty { reads [Invoice]; kernel_reads latent [Invoice.difficulty]; writes right; duration fixed 1min; outcomes kernel L }
  }
  process Flow { a = Reader.first(); b = Reader.second(); end done }
  cut Scope { question "案件ごとの文書"; include [Invoice,Reader] }
  arrivals fixed [0min, 0min]
  policy fifo tie_by case_id


  bounds { cases 2; live_tasks 2; clock 30min }
  verify probability reached left == difficult && right == difficult <= 1
  verify probability reached (left == routine && right == difficult) || (left == difficult && right == routine) <= 1
}
