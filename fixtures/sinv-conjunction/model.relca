model StateInvariant version "0.2" {
  type V = enum { pass }
  observed case { po: optional<V>; receipt: optional<V>; registered: bool = false }
  actor Ledger { capacity 1; capability post() -> V { duration fixed 1min; result nondet { pass }; writes registered; finish { registered = true } } }
  actor Clerk { capacity 2
    capability po() -> V { duration fixed 5min; result nondet { pass }; writes po }
    capability receipt() -> V { duration fixed 3min; result nondet { pass }; writes receipt }
  }
  process Flow { fork f { a = Clerk.po(); b = Clerk.receipt() }; join all f; p = Ledger.post(); end done }
  cut C { include [Clerk, Ledger] }
  bounds { cases 1; live_tasks 2; clock 10min }

  contract Controls { invariant registered -> po == pass && receipt == pass }
}
