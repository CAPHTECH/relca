model StandingEffects version "0.2" {
  type Verdict = enum { pass, fail }
  type Ack = enum { committed }
  people [c1, a1, cfo]
  actor Approver { executors [a1]; capability approve() -> Verdict { duration fixed 2min; result nondet { pass, fail } } }
  actor Ledger { capacity 1; capability post() -> Ack { commits; duration fixed 1min; result nondet { committed } } }
  actor Clerk { executors [c1]; capability recheck() -> Verdict { duration fixed 5min; result nondet { pass, fail } } }
  actor Fast { capacity 1; capability go() -> Verdict { duration fixed 2min; result nondet { pass }; cancel cooperative ack_within 1min } }
  actor Slow { capacity 1; capability go() -> Verdict { duration fixed 6min; result nondet { fail }; cancel cooperative ack_within 1min } }
  actor Vendor { control party; standing over [Ledger.post.commit] basis "posting claim" }
  permit a1 to Approver.approve
  authority ApprovalGrant { basis "approval table"; grants a1 to Approver.approve; issued_by cfo }
  process Flow { approval = Approver.approve(); if approval == fail { end returned } else { }; ack = Ledger.post(); fork race { f = Fast.go(); s = Slow.go() } join any race where result == pass tie nondet remaining cancel_then_drain if none -> no_match; end posted; end no_match }
  cut Scope { include [Approver, Ledger, Clerk, Vendor, Fast, Slow] }
  bounds { cases 1; live_tasks 3; clock 20min }
  verify safety no_resource_overcommit
  contract Controls { contest Vendor on Ledger.post.commit route Clerk.recheck reversible_by [a1] respond_by 5min }
}
