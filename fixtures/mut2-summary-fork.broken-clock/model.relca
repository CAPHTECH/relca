model Summary version "0.2" {
  type Entry = enum { entry }
  type Verdict = enum { pass, fail }
  type Ack = enum { posted }
  actor Invoice { source document }
  actor PurchaseOrder { source record }
  actor Extract { via model "doc@v3"; capacity 1; capability make() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor ReceiptRecord { source record }
  actor Clerk { capacity 2; capability match_po(e:Entry) -> Verdict { reads [PurchaseOrder]; duration fixed 3min; result nondet { pass, fail } } capability match_receipt(e:Entry) -> Verdict { reads [ReceiptRecord]; duration fixed 5min; result nondet { pass, fail } } }
  actor Ledger { capacity 1; capability post(p:Verdict,a:Verdict) -> Ack { commits; duration fixed 1min; result nondet { posted } } }
  process Flow {
    e = Extract.make(); fork checks { p = Clerk.match_po(e); r = Clerk.match_receipt(e) } join all checks
    if p == pass && r == pass {} else { end rejected }
    z = Ledger.post(p,r); end done
  }
  cut Scope { include [Invoice,PurchaseOrder,Extract,Clerk,Ledger,ReceiptRecord] }
  bounds { cases 1; live_tasks 2; clock 7min }
  verify reachable end.done
  verify safety no_resource_overcommit
}
