model T version "0.2" {
  type V = enum { pass, fail }
  kernel Review { * -> { 0.5: pass; 0.5: fail } }
  observed case { brief: optional<V>; memo: optional<V> }
  actor Doc { source document }
  actor Policy { source document }
  actor Extra { source document }
  actor Notes {}
  actor Copy {}
  actor Third {}
  actor Clerk { capacity 1
    capability intake() -> V { reads [Doc]; writes brief; duration fixed 1min; result nondet { pass } }
    capability base() -> V { reads [Doc, Policy]; writes brief; duration fixed 1min; result nondet { pass } }
    capability patchD() -> V { reads [Doc]; writes brief; duration fixed 1min; result nondet { pass } }
    capability patchP() -> V { reads [Policy]; writes brief; duration fixed 1min; result nondet { pass } }
    capability patch() -> V { writes brief; duration fixed 1min; result nondet { pass } }
    capability patchd() -> V { reads [Doc]; writes brief; duration fixed 1min; result nondet { pass } }
    capability draft() -> V {  duration fixed 1min; result nondet { pass } }
    capability save() -> V { reads [Doc]; registers [Notes]; duration fixed 1min; result nondet { pass } }
    capability blank() -> V { registers [Notes]; duration fixed 1min; result nondet { pass } }
    capability saveb() -> V { reads [brief]; registers [Notes]; duration fixed 1min; result nondet { pass } }
    capability review() -> V { duration fixed 1min; outcomes kernel Review }
    capability review2() -> V { duration fixed 1min; outcomes kernel Review }
  }
  actor Boss { capacity 1
    capability use(d: V) -> V { reads [Notes]; duration fixed 1min; result nondet { pass } }
  }
  cut C { include [Doc, Policy, Extra, Notes, Copy, Third, Clerk, Boss] }
  process PLoop {
    repeat rework at_most 1 {
      d = Clerk.draft()
      b1 = Clerk.base()
      c = Clerk.review()
      if c == pass {
        g0 = Clerk.review2()
        if g0 == pass { x1 = Clerk.patchD() } else {}
        r = Clerk.saveb()
        leave
      } else { again }
    } on_limit {
      g = Clerk.review2()
      if g == pass { x2 = Clerk.patchP() } else {}
      r3 = Clerk.saveb()
      leave
    }
    u = Boss.use(d)
    end done
  }
  process PHand { d1 = Clerk.draft(); c1 = Clerk.review(); if c1 == pass { r1 = Clerk.save(); u1 = Boss.use(d1); end done } else { g = Clerk.review2(); if g == pass { i = Clerk.intake() } else { p = Clerk.patch() }; r3 = Clerk.saveb(); u2 = Boss.use(d1); end done } }
  configuration Loop { cut C; process PLoop }
  configuration Hand { cut C; process PHand }

  bounds { cases 1; live_tasks 1; clock 60min }
  contract Basis { evidence_basis Boss.use [Doc, Policy] }
}
