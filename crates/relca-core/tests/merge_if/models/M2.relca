model M2 version "0.2" {
  type D = enum { draft, repaired }
  type V = enum { pass, fail, reject }
  type Ack = enum { sent }
  actor Invoice { source document }
  actor Manual { source record }
  kernel Review { * -> { 0.5: pass; 0.25: fail; 0.25: reject } }
  actor Clerk { capacity 1
    capability write() -> D { reads [Invoice]; duration fixed 1min; result nondet { draft } }
    capability fix(d:D) -> D { reads [Manual]; duration fixed 2min; result nondet { repaired } }
  }
  actor Rev { capacity 1; capability review(d:D) -> V { duration fixed 1min; outcomes kernel Review } }
  actor Ledger { capacity 1; capability send(d:D) -> Ack { commits; duration fixed 1min; result nondet { sent } } }
  process Flow {
    d = Clerk.write()
    r = Rev.review(d)
    d2 = if r == reject { end rejected } else {
      g = if r == fail { f = Clerk.fix(d); yield f } else { yield d }
      yield g
    }
    s = Ledger.send(d2)
    if d2 == repaired { end done_fixed } else { end done_as_is }
  }
  cut C { include [Invoice, Manual, Clerk, Rev, Ledger] }
  bounds { cases 1; live_tasks 2; clock 30min }
  metrics { window 30min; currency "JPY"; rate Clerk per_minute 1; rate Rev per_minute 1; rate Ledger per_minute 1; rate Clerk.write per_start 1; rate Clerk.fix per_start 1; rate Rev.review per_start 1; rate Ledger.send per_start 1; breakdown waits }
  verify safety no_resource_overcommit
  verify probability reached end.done_fixed >= 0.25
  verify probability reached end.done_as_is >= 0.5
  verify probability reached end.rejected >= 0.25
}
