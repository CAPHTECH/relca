model RespDup version "0.2" {
  type Entry = enum { entry, repaired }
  type Verdict = enum { pass, fail }
  type Ack = enum { committed }
  people [a1]
  actor Invoice { source document }
  actor Manual { source record }
  actor Reader { capacity 1; capability enter() -> Entry { reads [Invoice]; duration fixed 1min; result nondet { entry } } }
  actor Rev { capacity 1; capability review(e:Entry) -> Verdict { duration fixed 1min; result nondet { pass, fail } } }
  actor Fixer { capacity 1; capability fix(e:Entry) -> Entry { reads [Manual]; duration fixed 1min; result nondet { repaired } } }
  actor Approver { executors [a1]; capability approve(e:Entry) -> Verdict { reads [Invoice]; duration fixed 1min; result nondet { pass,fail } } }
  actor Ledger { capacity 1; capability post(v:Verdict) -> Ack { commits; duration fixed 1min; result nondet { committed } } }
  responsible a1 for Approver.approve
  process Flow {
    entry = Reader.enter()
    r = Rev.review(entry)
    if r == fail { f = Fixer.fix(entry); a1x = Approver.approve(f); p1 = Ledger.post(a1x); end done } else { a2x = Approver.approve(entry); p2 = Ledger.post(a2x); end done }
  }
  cut Scope { include [Invoice,Manual,Reader,Rev,Fixer,Approver,Ledger] }
  bounds { cases 1; live_tasks 2; clock 20min }
  verify safety no_resource_overcommit
}
