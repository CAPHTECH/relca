    "old": "model CaseSet version \"0.2\" {\n  type Ack = enum { committed, rejected_duplicate }\n  type S=enum{idle,busy}\n  type T = enum { ok, no }\n  people [c1,c2]\n  observed case { registered: bool = false }\n\n  actor Ledger { capacity 2; state status:S=idle; state keys: set<CaseId>; capability post(key: CaseId) -> Ack {\n      commits\n      writes [keys, registered]\n      duration fixed 1min\n      atomic {\n        if key in keys { result rejected_duplicate }\n        else { keys += key; registered = true; result committed }\n      }\n      cancel forbidden_after_start\n    } }\n  process Flow { a = Ledger.post(case.id); end done }\n  cut K { include [Ledger] }\n  arrivals fixed [0min,0min]\n  policy fifo tie_by case_id\n  bounds { cases 2; live_tasks 3; clock 20min }\n  contract C { at_most_once Ledger.post.commit per case.id }\n  verify reachable end.done\n}\n",
    "new": "model CaseSet version \"0.2\" {\n  type Ack = enum { committed, rejected_duplicate }\n  type S=enum{idle,busy}\n  type T = enum { ok, no }\n  people [c1,c2]\n  observed case { registered: bool = false }\n\n  actor Ledger { capacity 2; state status:S=idle; state keys: set<CaseId>; capability post(key: CaseId) -> Ack {\n      commits\n      writes [keys, registered, status]\n      duration fixed 1min\n      atomic {\n        if key in keys { result rejected_duplicate }\n        else { keys += key; registered = true; status = busy; result committed }\n      }\n      cancel forbidden_after_start\n    } }\n  process Flow { a = Ledger.post(case.id); end done }\n  cut K { include [Ledger] }\n  arrivals fixed [0min,0min]\n  policy fifo tie_by case_id\n  bounds { cases 2; live_tasks 3; clock 20min }\n  contract C { at_most_once Ledger.post.commit per case.id }\n  verify reachable end.done\n}\n"
