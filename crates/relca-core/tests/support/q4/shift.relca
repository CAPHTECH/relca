model Shift version "0.2" {
  type R = enum { ok }
  people [p, q]
  calendar Always through 21min on_close continue { [0min, 21min) capacity 2 }
  calendar Early through 21min on_close continue { [0min, 3min) capacity 1; [3min, 21min) capacity 0 }
  calendar Late through 21min on_close continue { [0min, 3min) capacity 0; [3min, 21min) capacity 1 }
  person_calendar p Early
  person_calendar q Late
  actor Desk { executors [p, q]; calendar Always
    capability run() -> R { duration fixed 5min; result nondet { ok } }
  }
  process Flow { r = Desk.run(); end done }
  cut C { include [Desk] }
  arrivals fixed [0min, 3min]
  policy observable fifo tie_by case_id then call_order assign first_idle
  bounds { cases 2; live_tasks 2; clock 20min }
  metrics { window 20min; currency "JPY"; rate Desk per_minute 2; rate Desk overtime_per_minute 3; rate Desk.run per_start 0; breakdown waits }
  verify reachable end.done
  verify safety no_resource_overcommit
}
