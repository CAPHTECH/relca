model RetryCalendar version "0.2" {
  type Ack = enum { committed, rejected_duplicate }
  observed case { registered: bool = false }
  calendar Day through 21min on_close continue { [0min, 1min) capacity 1; [1min, 4min) capacity 0; [4min, 21min) capacity 1 }
  actor Ledger { capacity 1; calendar Day; state keys: set<CaseId>
    capability post(key: CaseId) -> Ack {
      commits; writes [keys, registered]; duration fixed 1min
      idempotency key key
      atomic { if key in keys { result rejected_duplicate }
        else { keys += key; registered = true; result committed } }
      cancel forbidden_after_start
    }
  }
  process Flow {
    ack = Ledger.post(case.id) response_loss sequence [unknown, delivered]
      retry max_attempts 2 when receipt unknown backoff fixed 0min exhausted end failed
    if ack == rejected_duplicate { end duplicate } else { end posted }
  }
  cut C { include [Ledger] }
  arrivals fixed [0min]
  bounds { cases 1; live_tasks 2; clock 20min }
  contract Once { at_most_once Ledger.post.commit per case.id }
  verify safety no_resource_overcommit
  verify probability reached registered == true >= 1
}
