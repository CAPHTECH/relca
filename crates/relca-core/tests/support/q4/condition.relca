model Condition version "0.2" {
  type R = enum { owner, waiter, ok }
  calendar Always through 21min on_close continue { [0min, 21min) capacity 1 }
  calendar Two through 21min on_close continue { [0min, 21min) capacity 2 }
  actor Board { capacity 2; calendar Two
    state requests: 0..2 = 0
    state ready: bool = false last_write_wins
    capability set() -> R { requires requests == 0 else waiter; duration fixed 4min; result nondet { owner }; writes ready; start { requests += 1 }; finish { ready = true } }
  }
  actor Desk { capacity 1; calendar Always
    capability run() -> R { duration fixed 2min; result nondet { ok } }
  }
  process Flow {
    s = Board.set()
    if s == owner { end done }
    else { wait until Board.ready == true; r = Desk.run(); end done }
  }
  cut C { include [Board, Desk] }
  arrivals fixed [0min, 0min]
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 2; clock 20min }
  metrics { window 20min; currency "JPY"; rate Board per_minute 1; rate Desk per_minute 1; rate Board.set per_start 0; rate Desk.run per_start 0; breakdown waits }
  verify reachable end.done
  verify safety no_resource_overcommit
}
