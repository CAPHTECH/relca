model ConditionConstant version "0.2" {
  type R = enum { ok }
  observed case { ready: bool = true }
  actor Desk { capacity 1
    capability run() -> R { duration fixed 2min; result nondet { ok } }
  }
  process Flow { wait until ready == true; r = Desk.run(); end done }
  cut C { include [Desk] }
  arrivals fixed [0min]
  bounds { cases 1; live_tasks 2; clock 20min }
  metrics { window 20min; currency "JPY"; rate Desk per_minute 1; rate Desk.run per_start 0; breakdown waits }
  verify reachable end.done
  verify safety no_resource_overcommit
}
