model ArrivalDistribution version "0.2" {
  type R = enum { ok }
  actor Desk { capacity 1
    capability run() -> R { duration fixed 3min; result nondet { ok } }
  }
  process Flow { r = Desk.run(); end done }
  cut C { include [Desk] }
  arrivals distribution basis "fixture assumption; not measured" {
    0.5: fixed [0min, 0min]
    0.5: fixed [0min, 4min]
  }
  policy fifo tie_by case_id
  bounds { cases 2; live_tasks 2; clock 20min }
  simulation replications 4 seed 1 confidence 0.5
  metrics { window 20min; currency "JPY"; rate Desk per_minute 2; rate Desk.run per_start 0; breakdown waits }
  verify probability reached end.done within 4min >= 0
}
