model RatioRows version "0.2" {
  type T = enum { ok }
  actor A { capacity 1; capability run() -> T { duration fixed 1min; result nondet { ok } } }
  process P { x=A.run(); end done }
  cut C { include [A] }
  arrivals fixed [0min, 2min]
  bounds { cases 2; live_tasks 1; clock 10min }
  simulation replications 1 seed 1 confidence 0.5
  verify safety no_resource_overcommit
  property case.Done = reached(end.done)
  metric cohort.Ratio = expected(count(case.Done)) / expected(count(case.Done))
  verify metric cohort.Ratio >= 0.1
  verify metric cohort.Ratio >= 0
}
