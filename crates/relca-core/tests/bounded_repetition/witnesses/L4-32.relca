model OldWitness version "0.2" {
type V = enum { pass, fail }
type R = enum { v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12,v13,v14,v15,v16,v17,v18,v19,v20,v21,v22,v23,v24,v25,v26,v27,v28,v29,v30,v31,v32 }
observed case { round: R = v1 }
kernel K given [round] {
v1 -> { 0.5: fail with round = v2; 0.5: pass with round = v2 };
v2 -> { 0.2: fail with round = v3; 0.8: pass with round = v3 };
v3 -> { 0.1: fail with round = v4; 0.9: pass with round = v4 };
v4 -> { 0.1: fail with round = v5; 0.9: pass with round = v5 };
v5 -> { 0.1: fail with round = v6; 0.9: pass with round = v6 };
v6 -> { 0.1: fail with round = v7; 0.9: pass with round = v7 };
v7 -> { 0.1: fail with round = v8; 0.9: pass with round = v8 };
v8 -> { 0.1: fail with round = v9; 0.9: pass with round = v9 };
v9 -> { 0.1: fail with round = v10; 0.9: pass with round = v10 };
v10 -> { 0.1: fail with round = v11; 0.9: pass with round = v11 };
v11 -> { 0.1: fail with round = v12; 0.9: pass with round = v12 };
v12 -> { 0.1: fail with round = v13; 0.9: pass with round = v13 };
v13 -> { 0.1: fail with round = v14; 0.9: pass with round = v14 };
v14 -> { 0.1: fail with round = v15; 0.9: pass with round = v15 };
v15 -> { 0.1: fail with round = v16; 0.9: pass with round = v16 };
v16 -> { 0.1: fail with round = v17; 0.9: pass with round = v17 };
v17 -> { 0.1: fail with round = v18; 0.9: pass with round = v18 };
v18 -> { 0.1: fail with round = v19; 0.9: pass with round = v19 };
v19 -> { 0.1: fail with round = v20; 0.9: pass with round = v20 };
v20 -> { 0.1: fail with round = v21; 0.9: pass with round = v21 };
v21 -> { 0.1: fail with round = v22; 0.9: pass with round = v22 };
v22 -> { 0.1: fail with round = v23; 0.9: pass with round = v23 };
v23 -> { 0.1: fail with round = v24; 0.9: pass with round = v24 };
v24 -> { 0.1: fail with round = v25; 0.9: pass with round = v25 };
v25 -> { 0.1: fail with round = v26; 0.9: pass with round = v26 };
v26 -> { 0.1: fail with round = v27; 0.9: pass with round = v27 };
v27 -> { 0.1: fail with round = v28; 0.9: pass with round = v28 };
v28 -> { 0.1: fail with round = v29; 0.9: pass with round = v29 };
v29 -> { 0.1: fail with round = v30; 0.9: pass with round = v30 };
v30 -> { 0.1: fail with round = v31; 0.9: pass with round = v31 };
v31 -> { 0.1: fail with round = v32; 0.9: pass with round = v32 };
v32 -> { 0.1: fail with round = v32; 0.9: pass with round = v32 };
}
actor Rev { capacity 1; capability review() -> V { duration fixed 1min; outcomes kernel K; reads [round]; writes round } }
actor Clerk { capacity 1; capability fix() -> V { duration fixed 2min; result nondet { pass } } }

process P { r1 = Rev.review(); if r1 == pass { end done } else { f1 = Clerk.fix(); r2 = Rev.review(); if r2 == pass { end done } else { f2 = Clerk.fix(); r3 = Rev.review(); if r3 == pass { end done } else { f3 = Clerk.fix(); r4 = Rev.review(); if r4 == pass { end done } else { f4 = Clerk.fix(); r5 = Rev.review(); if r5 == pass { end done } else { f5 = Clerk.fix(); r6 = Rev.review(); if r6 == pass { end done } else { f6 = Clerk.fix(); r7 = Rev.review(); if r7 == pass { end done } else { f7 = Clerk.fix(); r8 = Rev.review(); if r8 == pass { end done } else { f8 = Clerk.fix(); r9 = Rev.review(); if r9 == pass { end done } else { f9 = Clerk.fix(); r10 = Rev.review(); if r10 == pass { end done } else { f10 = Clerk.fix(); r11 = Rev.review(); if r11 == pass { end done } else { f11 = Clerk.fix(); r12 = Rev.review(); if r12 == pass { end done } else { f12 = Clerk.fix(); r13 = Rev.review(); if r13 == pass { end done } else { f13 = Clerk.fix(); r14 = Rev.review(); if r14 == pass { end done } else { f14 = Clerk.fix(); r15 = Rev.review(); if r15 == pass { end done } else { f15 = Clerk.fix(); r16 = Rev.review(); if r16 == pass { end done } else { f16 = Clerk.fix(); r17 = Rev.review(); if r17 == pass { end done } else { f17 = Clerk.fix(); r18 = Rev.review(); if r18 == pass { end done } else { f18 = Clerk.fix(); r19 = Rev.review(); if r19 == pass { end done } else { f19 = Clerk.fix(); r20 = Rev.review(); if r20 == pass { end done } else { f20 = Clerk.fix(); r21 = Rev.review(); if r21 == pass { end done } else { f21 = Clerk.fix(); r22 = Rev.review(); if r22 == pass { end done } else { f22 = Clerk.fix(); r23 = Rev.review(); if r23 == pass { end done } else { f23 = Clerk.fix(); r24 = Rev.review(); if r24 == pass { end done } else { f24 = Clerk.fix(); r25 = Rev.review(); if r25 == pass { end done } else { f25 = Clerk.fix(); r26 = Rev.review(); if r26 == pass { end done } else { f26 = Clerk.fix(); r27 = Rev.review(); if r27 == pass { end done } else { f27 = Clerk.fix(); r28 = Rev.review(); if r28 == pass { end done } else { f28 = Clerk.fix(); r29 = Rev.review(); if r29 == pass { end done } else { f29 = Clerk.fix(); r30 = Rev.review(); if r30 == pass { end done } else { f30 = Clerk.fix(); r31 = Rev.review(); if r31 == pass { end done } else { f31 = Clerk.fix(); r32 = Rev.review(); if r32 == pass { end done } else { f32 = Clerk.fix(); end escalated } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
cut C { include [Rev, Clerk] }
bounds { cases 1; live_tasks 1; clock 200min }
metrics { window 200min; currency "JPY"; rate Rev per_minute 1; rate Clerk per_minute 1; rate Rev.review per_start 1; rate Clerk.fix per_start 1; breakdown waits }
verify safety no_resource_overcommit
verify probability reached end.done within 1min >= 0.5
verify probability reached end.done within 4min >= 0.9
verify probability reached end.done within 7min >= 0.99
verify probability reached end.escalated >= 0.0000000000000000000000000000001
}
