actor Wh { capacity 1; capability check() -> Stock { duration fixed 1min; outcomes kernel Seen; kernel_reads latent [ready]; reads [round]; writes round } }
actor Ship { capacity 1; capability send() -> Stock { duration fixed 5min; result nondet { arrived } } }

process P { c1 = Wh.check(); if c1 == arrived { s1 = Ship.send(); end shipped } else { wait 30min; c2 = Wh.check(); if c2 == arrived { s2 = Ship.send(); end shipped } else { wait 30min; c3 = Wh.check(); if c3 == arrived { s3 = Ship.send(); end shipped } else { wait 30min; c4 = Wh.check(); if c4 == arrived { s4 = Ship.send(); end shipped } else { wait 30min; c5 = Wh.check(); if c5 == arrived { s5 = Ship.send(); end shipped } else { wait 30min; c6 = Wh.check(); if c6 == arrived { s6 = Ship.send(); end shipped } else { wait 30min; c7 = Wh.check(); if c7 == arrived { s7 = Ship.send(); end shipped } else { wait 30min; c8 = Wh.check(); if c8 == arrived { s8 = Ship.send(); end shipped } else { wait 30min; c9 = Wh.check(); if c9 == arrived { s9 = Ship.send(); end shipped } else { wait 30min; c10 = Wh.check(); if c10 == arrived { s10 = Ship.send(); end shipped } else { wait 30min; c11 = Wh.check(); if c11 == arrived { s11 = Ship.send(); end shipped } else { wait 30min; c12 = Wh.check(); if c12 == arrived { s12 = Ship.send(); end shipped } else { wait 30min; c13 = Wh.check(); if c13 == arrived { s13 = Ship.send(); end shipped } else { wait 30min; c14 = Wh.check(); if c14 == arrived { s14 = Ship.send(); end shipped } else { wait 30min; c15 = Wh.check(); if c15 == arrived { s15 = Ship.send(); end shipped } else { wait 30min; c16 = Wh.check(); if c16 == arrived { s16 = Ship.send(); end shipped } else { wait 30min; c17 = Wh.check(); if c17 == arrived { s17 = Ship.send(); end shipped } else { wait 30min; c18 = Wh.check(); if c18 == arrived { s18 = Ship.send(); end shipped } else { wait 30min; c19 = Wh.check(); if c19 == arrived { s19 = Ship.send(); end shipped } else { wait 30min; c20 = Wh.check(); if c20 == arrived { s20 = Ship.send(); end shipped } else { wait 30min; c21 = Wh.check(); if c21 == arrived { s21 = Ship.send(); end shipped } else { wait 30min; c22 = Wh.check(); if c22 == arrived { s22 = Ship.send(); end shipped } else { wait 30min; c23 = Wh.check(); if c23 == arrived { s23 = Ship.send(); end shipped } else { wait 30min; c24 = Wh.check(); if c24 == arrived { s24 = Ship.send(); end shipped } else { wait 30min; c25 = Wh.check(); if c25 == arrived { s25 = Ship.send(); end shipped } else { wait 30min; c26 = Wh.check(); if c26 == arrived { s26 = Ship.send(); end shipped } else { wait 30min; c27 = Wh.check(); if c27 == arrived { s27 = Ship.send(); end shipped } else { wait 30min; c28 = Wh.check(); if c28 == arrived { s28 = Ship.send(); end shipped } else { wait 30min; c29 = Wh.check(); if c29 == arrived { s29 = Ship.send(); end shipped } else { wait 30min; c30 = Wh.check(); if c30 == arrived { s30 = Ship.send(); end shipped } else { wait 30min; c31 = Wh.check(); if c31 == arrived { s31 = Ship.send(); end shipped } else { wait 30min; c32 = Wh.check(); if c32 == arrived { s32 = Ship.send(); end shipped } else { end gave_up } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
cut C { include [Wh, Ship] }
bounds { cases 1; live_tasks 1; clock 2000min }
metrics { window 2000min; currency "JPY"; rate Wh per_minute 1; rate Ship per_minute 1; rate Wh.check per_start 1; rate Ship.send per_start 1; breakdown waits }
verify safety no_resource_overcommit
verify probability reached end.shipped within 6min >= 0.5
verify probability reached end.shipped within 37min >= 0.625
verify probability reached end.shipped within 68min >= 0.75
verify probability reached end.gave_up within 962min >= 0.25
