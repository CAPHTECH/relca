model OldWitness version "0.2" {
type Stock = enum { arrived, not_yet }
type Ready = enum { r1,r2,r3,never }
type R = enum { v1,v2,v3 }
observed case { round: R = v1 }
latent case { ready: Ready ~ { r1: 0.5, r2: 0.125, r3: 0.125, never: 0.25 } }
kernel Seen given [ready, round] {
r1, v1 -> { 1: arrived with round = v2 };
r1, v2 -> { 1: arrived with round = v3 };
r1, v3 -> { 1: arrived with round = v3 };
r2, v1 -> { 1: not_yet with round = v2 };
r2, v2 -> { 1: arrived with round = v3 };
r2, v3 -> { 1: arrived with round = v3 };
r3, v1 -> { 1: not_yet with round = v2 };
r3, v2 -> { 1: not_yet with round = v3 };
r3, v3 -> { 1: arrived with round = v3 };
never, v1 -> { 1: not_yet with round = v2 };
never, v2 -> { 1: not_yet with round = v3 };
never, v3 -> { 1: not_yet with round = v3 };
}
actor Wh { capacity 1; capability check() -> Stock { duration fixed 1min; outcomes kernel Seen; kernel_reads latent [ready]; reads [round]; writes round } }
actor Ship { capacity 1; capability send() -> Stock { duration fixed 5min; result nondet { arrived } } }

process P { c1 = Wh.check(); if c1 == arrived { s1 = Ship.send(); end shipped } else { wait 30min; c2 = Wh.check(); if c2 == arrived { s2 = Ship.send(); end shipped } else { wait 30min; c3 = Wh.check(); if c3 == arrived { s3 = Ship.send(); end shipped } else { end gave_up } } } }
cut C { include [Wh, Ship] }
bounds { cases 1; live_tasks 1; clock 200min }
metrics { window 200min; currency "JPY"; rate Wh per_minute 1; rate Ship per_minute 1; rate Wh.check per_start 1; rate Ship.send per_start 1; breakdown waits }
verify safety no_resource_overcommit
verify probability reached end.shipped within 6min >= 0.5
verify probability reached end.shipped within 37min >= 0.625
verify probability reached end.shipped within 68min >= 0.75
verify probability reached end.gave_up within 63min >= 0.25
}
