model OldWitness version "0.2" {
type V = enum { pass, fail }
latent case { bad: bool ~ { true: 0.1, false: 0.9 } }
kernel K given [bad] { true -> { 1: fail }; false -> { 1: pass } }
actor Rev { capacity 1; capability review() -> V { duration fixed 1min; outcomes kernel K; kernel_reads latent [bad] } }
actor Clerk { capacity 1; capability fix() -> V { duration fixed 2min; result nondet { pass } } }

process P { r1 = Rev.review(); if r1 == pass { end done } else { f1 = Clerk.fix(); r2 = Rev.review(); if r2 == pass { end done } else { f2 = Clerk.fix(); r3 = Rev.review(); if r3 == pass { end done } else { f3 = Clerk.fix(); r4 = Rev.review(); if r4 == pass { end done } else { f4 = Clerk.fix(); r5 = Rev.review(); if r5 == pass { end done } else { f5 = Clerk.fix(); r6 = Rev.review(); if r6 == pass { end done } else { f6 = Clerk.fix(); r7 = Rev.review(); if r7 == pass { end done } else { f7 = Clerk.fix(); r8 = Rev.review(); if r8 == pass { end done } else { f8 = Clerk.fix(); r9 = Rev.review(); if r9 == pass { end done } else { f9 = Clerk.fix(); r10 = Rev.review(); if r10 == pass { end done } else { f10 = Clerk.fix(); r11 = Rev.review(); if r11 == pass { end done } else { f11 = Clerk.fix(); r12 = Rev.review(); if r12 == pass { end done } else { f12 = Clerk.fix(); r13 = Rev.review(); if r13 == pass { end done } else { f13 = Clerk.fix(); r14 = Rev.review(); if r14 == pass { end done } else { f14 = Clerk.fix(); r15 = Rev.review(); if r15 == pass { end done } else { f15 = Clerk.fix(); r16 = Rev.review(); if r16 == pass { end done } else { f16 = Clerk.fix(); r17 = Rev.review(); if r17 == pass { end done } else { f17 = Clerk.fix(); r18 = Rev.review(); if r18 == pass { end done } else { f18 = Clerk.fix(); r19 = Rev.review(); if r19 == pass { end done } else { f19 = Clerk.fix(); r20 = Rev.review(); if r20 == pass { end done } else { f20 = Clerk.fix(); r21 = Rev.review(); if r21 == pass { end done } else { f21 = Clerk.fix(); r22 = Rev.review(); if r22 == pass { end done } else { f22 = Clerk.fix(); r23 = Rev.review(); if r23 == pass { end done } else { f23 = Clerk.fix(); r24 = Rev.review(); if r24 == pass { end done } else { f24 = Clerk.fix(); r25 = Rev.review(); if r25 == pass { end done } else { f25 = Clerk.fix(); r26 = Rev.review(); if r26 == pass { end done } else { f26 = Clerk.fix(); r27 = Rev.review(); if r27 == pass { end done } else { f27 = Clerk.fix(); r28 = Rev.review(); if r28 == pass { end done } else { f28 = Clerk.fix(); r29 = Rev.review(); if r29 == pass { end done } else { f29 = Clerk.fix(); r30 = Rev.review(); if r30 == pass { end done } else { f30 = Clerk.fix(); r31 = Rev.review(); if r31 == pass { end done } else { f31 = Clerk.fix(); r32 = Rev.review(); if r32 == pass { end done } else { f32 = Clerk.fix(); end escalated } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
cut C { include [Rev, Clerk] }
bounds { cases 1; live_tasks 1; clock 200min }
metrics { window 200min; currency "JPY"; rate Rev per_minute 1; rate Clerk per_minute 1; rate Rev.review per_start 1; rate Clerk.fix per_start 1; breakdown waits }
verify safety no_resource_overcommit
verify probability reached end.escalated <= 0.1
verify probability reached end.escalated >= 0.1
}
