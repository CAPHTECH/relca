model L2Pair version "0.2" {
  type V = enum { pass, fail }
  type F = enum { ok }
  latent case { bad: bool ~ { true: 0.1, false: 0.9 } }
  kernel rev given [bad] {
    true -> { 1: fail }
    false -> { 1: pass }
  }
  actor Rev { capacity 1; capability review() -> V { duration fixed 1min; outcomes kernel rev; kernel_reads latent [bad] } }
  actor Clerk { capacity 1; capability fix() -> F { duration fixed 2min; result nondet { ok } } }
  actor Mgr { capacity 1; capability decide() -> F { duration fixed 1min; result nondet { ok } } }
  process Looped {
    repeat rework at_most 3 {
      r = Rev.review()
      if r == pass { leave } else { f = Clerk.fix(); again }
    } on_limit { end escalated }
    end done
  }
  process Unrolled {
    r1 = Rev.review()
    if r1 == pass { end done } else {
      f1 = Clerk.fix()
      r2 = Rev.review()
      if r2 == pass { end done } else {
        f2 = Clerk.fix()
        r3 = Rev.review()
        if r3 == pass { end done } else {
          f3 = Clerk.fix()
          end escalated
        }
      }
    }
  }
  cut C { include [Rev, Clerk, Mgr] }
  configuration Loop { cut C; process Looped }
  configuration Hand { cut C; process Unrolled }
  bounds { cases 1; live_tasks 1; clock 30min }
  metrics { window 60min; currency "JPY" }
  verify probability reached end.escalated <= 0.2
}
