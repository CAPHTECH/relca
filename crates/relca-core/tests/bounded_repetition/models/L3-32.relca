model L3 version "0.2" {
  type V = enum { pass, fail }
  latent case { bad: bool ~ { true: 0.1, false: 0.9 } }
  kernel K given [bad] { true -> { 1: fail }; false -> { 1: pass } }
  kernel F given [bad] { true -> { 0.75: pass with bad = false; 0.25: pass with bad = true }; false -> { 1: pass with bad = false } }
  actor Rev { capacity 1; capability review() -> V { duration fixed 1min; outcomes kernel K; kernel_reads latent [bad] } }
  actor Clerk { capacity 1; capability fix() -> V { duration fixed 2min; outcomes kernel F; kernel_reads latent [bad]; writes bad } }
  process P {
    repeat rework at_most 32 {
      r = Rev.review()
      if r == pass { leave } else { f = Clerk.fix(); again }
    } on_limit { end escalated }
    end done
  }
  cut C { include [Rev, Clerk] }
  bounds { cases 1; live_tasks 1; clock 200min }
  metrics { window 200min; currency "JPY"; rate Rev per_minute 1; rate Clerk per_minute 1; rate Rev.review per_start 1; rate Clerk.fix per_start 1; breakdown waits }
  verify safety no_resource_overcommit
  verify probability reached end.done within 1min >= 0.9
  verify probability reached end.done within 4min >= 0.975
  verify probability reached end.done within 7min >= 0.99375
  verify probability reached end.escalated >= 0.000000000000000000021684043449710088680149056017398834228515625
}
