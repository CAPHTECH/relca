model EvidenceAliasE5 version "0.2" {
  type V = enum { pass, fail }
  kernel Review { * -> { 0.5: pass; 0.5: fail } }
  observed case { brief: optional<V> }
  actor Doc { source document }
  actor Clerk { capacity 1
    capability draft() -> V { reads [Doc]; writes brief; duration fixed 1min; result nondet { pass } }
    capability review() -> V { duration fixed 1min; outcomes kernel Review }
    capability fallback() -> V { writes brief; duration fixed 1min; result nondet { pass } }
  }
  actor Boss { capacity 1
    capability use(d: V) -> V { reads [brief]; duration fixed 1min; result nondet { pass } }
  }
  cut C { include [Doc, Clerk, Boss] }
  process Repeated {
    repeat rework at_most 2 {
      draft = Clerk.draft()
      d = Clerk.review()
      if d == pass { leave } else { again }
    } on_limit { last = Clerk.fallback(); leave }
    u = Boss.use(d)
    end done
  }
  process Written {
    draft1 = Clerk.draft(); d1 = Clerk.review()
    if d1 == pass { u1 = Boss.use(d1); end done } else {
      draft2 = Clerk.draft(); d2 = Clerk.review()
      if d2 == pass { u2 = Boss.use(d2); end done } else {
        last = Clerk.fallback(); u3 = Boss.use(d2); end done
      }
    }
  }
  configuration Loop { cut C; process Repeated }
  configuration Hand { cut C; process Written }
  bounds { cases 1; live_tasks 1; clock 20min }
  contract Basis { evidence_basis Boss.use [Doc] }
}
