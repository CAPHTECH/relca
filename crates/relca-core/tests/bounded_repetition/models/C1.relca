model C1 version "0.2" {
  type V = enum { pass, fail }
  type F = enum { ok }
  latent case { bad: bool ~ { true: 0.1, false: 0.9 } }
  kernel rev given [bad] {
    true -> { 1: fail }
    false -> { 1: pass }
  }
  actor Rev { capacity 1; capability review() -> V { duration fixed 1min; outcomes kernel rev; kernel_reads latent [bad] } }
  actor Clerk { capacity 1; capability fix() -> F { duration fixed 2min; result nondet { ok } } }
  process Looped3 {
    repeat rework3 at_most 3 {
      r = Rev.review()
      if r == pass { leave } else { f = Clerk.fix(); again }
    } on_limit { end escalated }
    end done
  }
  process Looped2 {
    repeat rework2 at_most 2 {
      r = Rev.review()
      if r == pass { leave } else { f = Clerk.fix(); again }
    } on_limit { end escalated }
    end done
  }
  process Unrolled3 {
    r1 = Rev.review()
    if r1 == pass { end done } else {
      f1 = Clerk.fix()
      r2 = Rev.review()
      if r2 == pass { end done } else {
        f2 = Clerk.fix()
        r3 = Rev.review()
        if r3 == pass { end done } else { f3 = Clerk.fix(); end escalated }
      }
    }
  }
  process Unrolled2 {
    r1 = Rev.review()
    if r1 == pass { end done } else {
      f1 = Clerk.fix()
      r2 = Rev.review()
      if r2 == pass { end done } else { f2 = Clerk.fix(); end escalated }
    }
  }
  cut C { include [Rev, Clerk] }
  configuration Loop3 { cut C; process Looped3 }
  configuration Loop2 { cut C; process Looped2 }
  configuration Hand3 { cut C; process Unrolled3 }
  configuration Hand2 { cut C; process Unrolled2 }
  bounds { cases 1; live_tasks 1; clock 30min }
  metrics { window 60min; currency "JPY" }
  verify probability reached end.escalated <= 0.2
}
