model ConfigurationContracts version "0.2" {
  type Result = enum { ok }
  people [clerk, boss]
  actor Desk {
    executors [clerk]
    capability pay() -> Result { duration fixed 1min; result nondet { ok } }
  }
  actor Screen {
    executors [boss]
    capability approve() -> Result { duration fixed 1min; result nondet { ok } }
  }
  permit clerk to Desk.pay
  permit boss to Screen.approve
  authority Mgr { basis "approval policy"; grants boss to Screen.approve; issued_by clerk }
  process AsIs { p = Desk.pay(); end done }
  process ToBe { a = Screen.approve(); p = Desk.pay(); end done }
  cut K { include [Desk, Screen] }
  configuration Old { cut K; process AsIs }
  configuration New { cut K; process ToBe }
  bounds { cases 1; live_tasks 1; clock 5min }
  verify reachable end.done
  contract Controls applies_to [New] reason "Oldには承認画面がない" {
    authority_basis Screen.approve Mgr
  }
}
